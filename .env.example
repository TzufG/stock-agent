# Stock Agent Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# ANTHROPIC (Claude AI)
# =============================================================================
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# TWILIO (WhatsApp)
# =============================================================================
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio WhatsApp number (e.g., whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Your personal WhatsApp number to receive alerts (e.g., whatsapp:+1234567890)
WHATSAPP_TO=whatsapp:+1234567890

# =============================================================================
# NEWS API (optional)
# =============================================================================
# Get your API key from https://newsapi.org/
NEWS_API_KEY=your_newsapi_key_here

# =============================================================================
# WATCHLIST
# =============================================================================
# Comma-separated list of stock/ETF tickers to monitor
WATCHLIST=AAPL,MSFT,QQQ,SPY

# =============================================================================
# ALERT SETTINGS
# =============================================================================
# Percentage threshold for price movement alerts (e.g., 3.0 means 3%)
PRICE_CHANGE_THRESHOLD=3.0

# =============================================================================
# SCHEDULING
# =============================================================================
# Time to send morning report in HH:MM format (24-hour, local time)
MORNING_REPORT_TIME=07:30

# How often to check prices in minutes
PRICE_CHECK_INTERVAL_MINUTES=15
