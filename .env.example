# Stock Agent Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# WATCHLIST
# =============================================================================
# Comma-separated list of stock/ETF tickers to monitor
WATCHLIST=GOOG,LMT,NVDA,PLTR,QTUM,BWXT,AAPL,COST

# =============================================================================
# ALERT SETTINGS
# =============================================================================
# Percentage threshold for price movement alerts (e.g., 3 means 3%)
PRICE_ALERT_THRESHOLD=3

# How often to check prices in minutes
PRICE_CHECK_INTERVAL=15

# =============================================================================
# DAILY BRIEFING SETTINGS
# =============================================================================
# Time to send daily briefing in HH:MM format (24-hour, local time)
DAILY_BRIEFING_TIME=08:00

# =============================================================================
# TWILIO (WhatsApp)
# =============================================================================
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio WhatsApp number (e.g., whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Your personal WhatsApp number to receive alerts (e.g., whatsapp:+1234567890)
TWILIO_WHATSAPP_TO=whatsapp:+1234567890

# =============================================================================
# NEWS API
# =============================================================================
# Get your API key from https://newsapi.org/
NEWSAPI_KEY=your_newsapi_key_here

# =============================================================================
# ANTHROPIC (Claude AI)
# =============================================================================
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude model to use for AI digest generation
CLAUDE_MODEL=claude-sonnet-4-20250514
