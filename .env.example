# Stock Agent Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# ANTHROPIC (Claude AI)
# =============================================================================
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# EMAIL (Gmail)
# =============================================================================
# Your Gmail address
SMTP_EMAIL=your_email@gmail.com

# Gmail App Password (NOT your regular password!)
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Select "Mail" and your device
# 3. Generate and copy the 16-character password
SMTP_PASSWORD=your_16_char_app_password

# Email address to receive alerts (can be same as SMTP_EMAIL)
EMAIL_TO=your_email@gmail.com

# =============================================================================
# NEWS API (optional)
# =============================================================================
# Get your API key from https://newsapi.org/
NEWS_API_KEY=

# =============================================================================
# WATCHLIST
# =============================================================================
# Comma-separated list of stock/ETF tickers to monitor
WATCHLIST=AAPL,MSFT,QQQ,SPY

# =============================================================================
# ALERT SETTINGS
# =============================================================================
# Percentage threshold for price movement alerts (e.g., 3.0 means 3%)
PRICE_CHANGE_THRESHOLD=3.0

# =============================================================================
# SCHEDULING
# =============================================================================
# Time to send morning report in HH:MM format (24-hour, local time)
MORNING_REPORT_TIME=07:30

# How often to check prices in minutes
PRICE_CHECK_INTERVAL_MINUTES=15
